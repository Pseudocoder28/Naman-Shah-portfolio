---
// The version for visitors who don't play poker: the same story as a morning newspaper.
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Paper from '../components/paper/Paper.astro';
import PaperBar from '../components/paper/PaperBar.astro';
import CommandPalette from '../components/palette/CommandPalette';
import { backToQuestion } from '../lib/seat';

const { site, straight } = (await getEntry('profile', 'main'))!.data;
// The palette's Navigate group on the paper: its pages, found by the plain word for each section.
const KEYWORDS: Record<string, string[]> = {
  front: ['home', 'top', 'about', 'front'],
  business: ['experience', 'work', 'jobs'],
  technology: ['projects', 'code'],
  'technology-more': ['projects', 'code'],
  sports: ['awards', 'contests', 'scores', 'math'],
  community: ['leadership', 'council', 'president'],
  classifieds: ['contact', 'hire', 'email'],
  back: ['poker', 'cards', 'table'],
};
const pages = (straight?.pages ?? []).map((page) => ({
  id: `p-${page.label.toLowerCase()}`,
  name: `${page.label} ${page.name}`,
  keywords: KEYWORDS[page.id],
}));
---

<Base path="/straight" plate={false} title={[straight?.masthead, site.name].filter(Boolean).join(' | ')} skip={{ href: '#p-a1', label: 'Skip to the front page' }}>
  <Fragment slot="head">
    {/* A refresh goes back to the poker page's question, before anything here paints. */}
    <script is:inline set:html={`if ((${backToQuestion.toString()})(performance.getEntriesByType('navigation')[0]?.type)) location.replace('/');`} />
    <script is:inline>
      // Wide screens with motion get the paper as a book, decided before first paint so nothing jumps.
      // Below 800px tall a book's pages can't hold their stories at the 15px floor, so shorter screens get the stack.
      // If the paper's script never arrives, the sheets fall back to a stack rather than a closed book.
      (() => {
        const root = document.documentElement;
        if (!matchMedia('(min-width: 1200px) and (min-height: 800px) and (prefers-reduced-motion: no-preference)').matches) return;
        root.classList.add('book-mode', 'intro');
        setTimeout(() => root.classList.contains('book-ready') || root.classList.remove('book-mode', 'intro'), 4000);
      })();
    </script>
  </Fragment>
  <PaperBar />
  <main class="desk">
    <Paper />
  </main>
  <CommandPalette client:idle site={site} pages={pages} />
</Base>

<style>
  /* The morning after: the same walnut, in daylight from a window up and to the left. */
  .desk {
    min-height: 100dvh;
    padding: 2rem 1rem 4rem;
    background:
      radial-gradient(ellipse 70% 60% at 25% 10%, color-mix(in srgb, var(--color-lamp) 16%, transparent), transparent 70%),
      repeating-linear-gradient(91deg, rgb(255 255 255 / 0.018) 0 2px, transparent 2px 11px),
      linear-gradient(var(--color-rail), var(--color-room));
  }

  :global(.book-mode) .desk {
    display: grid;
    place-items: center;
    height: 100dvh;
    overflow: hidden;
    padding: 3.25rem 4rem 3.25rem;
  }
</style>
