---
import { getCollection, getEntry, render } from 'astro:content';
import SectionTitle from './SectionTitle.astro';
import { PIPS, SUIT_OF } from '../../lib/deck';
import EquityReadout from '../hud/EquityReadout';

const { hand, boardIntro } = (await getEntry('profile', 'main'))!.data;

const projects = await Promise.all(
  (await getCollection('board'))
    .sort((a, b) => a.id.localeCompare(b.id))
    .map(async (project) => ({
      ...project,
      Details: (await render(project)).Content,
      // A card opens a sheet only when the sheet has more than the card face shows.
      hasSheet: Boolean(project.body?.trim()) || project.data.links.length > 0,
    })),
);
// A card face holds this many stack tags. The project sheet lists the whole stack.
const FACE_TAGS = 3;
const streets = [
  { street: 'flop', name: 'Flop' },
  { street: 'turn', name: 'Turn' },
  { street: 'river', name: 'River' },
];
const opens = (project: (typeof projects)[number]) =>
  project.hasSheet ? { type: 'button', commandfor: `sheet-${project.id}`, command: 'show-modal', 'aria-haspopup': 'dialog' } : {};
const face = (card: string) => {
  const suit = SUIT_OF[card[1] as keyof typeof SUIT_OF];
  return { rank: card[0] === 'T' ? '10' : card[0], pip: PIPS[suit], red: suit === 'hearts' || suit === 'diamonds' };
};
---

<section id="the-board" class="lamp-pool px-6 py-16 md:px-12 md:py-24">
  <div class="board-area mx-auto max-w-7xl">
    {/* On a wide screen the intro sits beside the heading, so the readout's button stays in view. */}
    <div class="head">
      <SectionTitle id="the-board" />
      {boardIntro && <p class="intro">{boardIntro}</p>}
    </div>
    {/* Phones get the board at a glance too: all five cards small in one row, face down until their
        street is dealt, right above the readout and its deal button, so a deal and its equity share
        the screen. The full cards follow under the readout as a row to swipe through. */}
    <div class="glance mt-6" data-glance>
      <div class="g-board" aria-hidden="true">
        {
          streets.map(({ street, name }) => (
            <div class="g-street">
              <span class="street-name">{name}</span>
              <span class="g-cards">
                {projects
                  .filter((project) => project.data.street === street)
                  .map((project) => {
                    const { rank, pip, red } = face(project.data.card);
                    return (
                      <span class:list={['g-card', { red }]} data-street={street}>
                        <span class="g-inner">
                          <span class="g-back" />
                          <span class="g-face">
                            {rank}
                            <span>{pip}</span>
                          </span>
                        </span>
                      </span>
                    );
                  })}
              </span>
            </div>
          ))
        }
      </div>
    </div>
    <div class="board mt-8">
      {
        streets.map(({ street, name }) => (
          <div class="street">
            <h3 class="street-name">{name}</h3>
            <ul class="cards" role="list">
              {projects
                .filter((project) => project.data.street === street)
                .map((project) => {
                  const { rank, pip, red } = face(project.data.card);
                  const Card = project.hasSheet ? 'button' : 'div';
                  return (
                    <li>
                      <Card class:list={['card card-stock', { red }]} {...opens(project)}>
                        <span class="index">
                          {rank}
                          <span>{pip}</span>
                        </span>
                        <span class="name">{project.data.name}</span>
                        {project.data.pitch && <span class="pitch">{project.data.pitch}</span>}
                        {project.data.metric && <span class="metric">{project.data.metric}</span>}
                        {project.data.stack.length > 0 && (
                          <span class="stack mt-auto">
                            {project.data.stack.slice(0, FACE_TAGS).map((tag) => (
                              <span>{tag}</span>
                            ))}
                          </span>
                        )}
                        <span class="index end" aria-hidden="true">
                          {rank}
                          <span>{pip}</span>
                        </span>
                      </Card>
                    </li>
                  );
                })}
            </ul>
            <span class="burn" aria-hidden="true" />
          </div>
        ))
      }
    </div>
    <EquityReadout client:idle hole={hand.hole} board={projects.map(({ data }) => ({ street: data.street, card: data.card }))} />
  </div>

  {
    projects
      .filter((project) => project.hasSheet)
      .map(({ id, data, Details }) => (
        <dialog id={`sheet-${id}`} class="sheet on-cream" aria-labelledby={`sheet-${id}-name`} closedby="any">
          <div class="flex items-start justify-between gap-6">
            <h3 id={`sheet-${id}-name`} class="text-h3">
              {data.name}
            </h3>
            <button type="button" class="close" commandfor={`sheet-${id}`} command="close">
              Close
            </button>
          </div>
          {data.pitch && <p class="mt-3">{data.pitch}</p>}
          {data.metric && <p class="metric mt-2">{data.metric}</p>}
          <div class="details mt-6">
            <Details />
          </div>
          {data.stack.length > 0 && (
            <ul class="stack mt-6" role="list">
              {data.stack.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )}
          {data.links.length > 0 && (
            <ul class="mt-6 flex flex-wrap gap-4" role="list">
              {data.links.map((link) => (
                <li>
                  <a href={link.href} target="_blank" rel="noopener" class="underline underline-offset-4">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </dialog>
      ))
  }
</section>

<script>
  // Invoker commands are Baseline since December 2025. Older browsers, like Safari before
  // 26.2 on older iPhones, get the same two commands here so project sheets still open.
  if (!('commandForElement' in HTMLButtonElement.prototype)) {
    document.addEventListener('click', (event) => {
      const button = (event.target as Element).closest('button[commandfor]');
      const dialog = button && document.getElementById(button.getAttribute('commandfor')!);
      if (!(dialog instanceof HTMLDialogElement)) return;
      if (button.getAttribute('command') === 'show-modal') dialog.showModal();
      if (button.getAttribute('command') === 'close') dialog.close();
    });
  }
</script>

<style>
  /* Three flop cards, a gap, the turn, a gap, the river. Phones and tablets scroll the row. */
  .board-area {
    container-type: inline-size;
  }

  /* What dealing does, for visitors who don't play. */
  .intro {
    max-width: 62ch;
    margin-top: 1rem;
    color: color-mix(in srgb, var(--color-cream) 85%, transparent);
  }

  @media (min-width: 1024px) {
    .head {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 4rem;
    }

    .intro {
      margin-top: 0;
      font-size: var(--text-small);
    }
  }

  /* ---- The board at a glance, on phones only. ---- */
  .glance {
    display: none;
  }

  /* On a phone the section reads: the cards at a glance, the readout and its deal button, then
     the full cards. */
  @media (max-width: 767px) {
    .glance {
      display: block;
    }

    .board-area {
      display: flex;
      flex-direction: column;
    }

    .board-area > .glance {
      order: 1;
    }

    /* The island is display: contents, so the readout inside it is the flex item. */
    .board-area :global(.equity) {
      order: 2;
    }

    .board-area > .board {
      order: 3;
    }
  }

  .g-board {
    display: flex;
    gap: 0.875rem;
    margin-bottom: 1.25rem;
  }

  .g-cards {
    display: flex;
    gap: 0.375rem;
    margin-top: 0.375rem;
  }

  .g-card {
    width: clamp(3rem, 14.5vw, 4rem);
    aspect-ratio: 63 / 88;
    perspective: 500px;
  }

  /* Face down until its street is dealt, then turned over. Without JavaScript they lie face up. */
  .g-inner {
    position: relative;
    display: block;
    height: 100%;
    transform: rotateY(180deg);
    transform-style: preserve-3d;
  }

  .g-back,
  .g-face {
    position: absolute;
    inset: 0;
    border-radius: 0.375rem;
    backface-visibility: hidden;
    box-shadow: 0 8px 14px -8px rgb(0 0 0 / 0.75);
  }

  .g-back {
    border: 0.2rem solid var(--color-cream);
    background: repeating-linear-gradient(
      45deg,
      var(--color-card-red) 0 0.2rem,
      color-mix(in srgb, var(--color-card-red), black 25%) 0.2rem 0.4rem
    );
  }

  .g-face {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--color-cream);
    color: var(--color-ink);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1;
    transform: rotateY(180deg);
  }

  .red .g-face {
    color: var(--color-card-red);
  }

  .board {
    --gap: 0.75rem;
    --street-gap: 2rem;
    --card: 15rem;
    display: flex;
    gap: var(--street-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 1rem;
  }

  @media (min-width: 1024px) {
    .board {
      --card: calc((100cqi - 2 * var(--street-gap) - 2 * var(--gap)) / 5);
      overflow: visible;
    }
  }

  .street {
    position: relative;
    flex: none;
  }

  /* The face-down card burned before each street. It only shows during the deal. */
  .burn {
    position: absolute;
    bottom: 0;
    left: 0;
    width: var(--card);
    aspect-ratio: 63 / 88;
    border: 0.5rem solid var(--color-cream);
    border-radius: var(--radius-card);
    background: repeating-linear-gradient(
      45deg,
      var(--color-card-red) 0 0.25rem,
      color-mix(in srgb, var(--color-card-red), black 25%) 0.25rem 0.5rem
    );
    box-shadow: 0 16px 28px -14px rgb(0 0 0 / 0.65);
    visibility: hidden;
    pointer-events: none;
  }

  .street-name {
    margin-bottom: 0.75rem;
    font-size: var(--text-small);
    color: color-mix(in srgb, var(--color-cream) 80%, transparent);
  }

  /* Slots size to their card, not to the row, so no outline shows below a card. */
  .cards {
    display: flex;
    align-items: flex-start;
    gap: var(--gap);
  }

  /* Where each card lands, a faint brass outline the card covers once it's dealt. */
  .cards > li {
    border-radius: var(--radius-card);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-brass) 30%, transparent);
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    /* Every card is exactly poker size, whatever its face holds, so a street's cards line up. */
    width: var(--card);
    height: calc(var(--card) * 88 / 63);
    overflow: hidden;
    padding: 4rem 1rem;
    font-size: var(--text-small);
    line-height: 1.45;
    text-align: left;
    scroll-snap-align: center;
  }

  .index {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1;
  }

  .index.end {
    top: auto;
    left: auto;
    right: 0.75rem;
    bottom: 0.75rem;
    rotate: 180deg;
  }

  .red .index {
    color: var(--color-card-red);
  }

  .name {
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .metric {
    margin-top: 0.25rem;
    color: var(--color-card-red);
  }

  /* The pitch gives way first when a face is full: four lines, three beside a metric. */
  .pitch {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    overflow: hidden;
  }

  .card:has(.metric) .pitch {
    -webkit-line-clamp: 3;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .stack > * {
    border: 1px solid color-mix(in srgb, var(--color-ink) 30%, transparent);
    border-radius: var(--radius-chip);
    padding: 0 0.5rem;
    font-size: 0.8125rem;
  }

  .sheet {
    width: min(40rem, calc(100% - 2rem));
    max-height: calc(100% - 2rem);
    margin: auto;
    border: 1px solid var(--color-brass);
    border-radius: var(--radius-panel);
    padding: 2rem;
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.7);
  }

  .sheet::backdrop {
    background: color-mix(in srgb, var(--color-room) 70%, transparent);
  }

  /* A short fade and scale both ways. CSS rather than GSAP, because Escape, a click outside and
     the close button all close the dialog natively, and only a transition can follow them out. */
  .sheet,
  .sheet::backdrop {
    transition:
      opacity 0.35s cubic-bezier(0.215, 0.61, 0.355, 1),
      scale 0.35s cubic-bezier(0.215, 0.61, 0.355, 1),
      overlay 0.35s allow-discrete,
      display 0.35s allow-discrete;
  }

  .sheet:not([open]),
  .sheet:not([open])::backdrop {
    opacity: 0;
  }

  .sheet:not([open]) {
    scale: 0.96;
  }

  @starting-style {
    .sheet[open],
    .sheet[open]::backdrop {
      opacity: 0;
    }

    .sheet[open] {
      scale: 0.96;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet,
    .sheet::backdrop {
      scale: none !important;
      transition-duration: 0.15s;
    }
  }

  .close {
    flex: none;
    border: 1px solid color-mix(in srgb, var(--color-ink) 40%, transparent);
    border-radius: var(--radius-chip);
    padding: 0.25rem 1rem;
  }

  .details :global(* + *) {
    margin-top: 1em;
  }

  /* Project write-ups list their facts as bullets. */
  .details :global(ul) {
    padding-left: 1.2em;
    list-style: disc;
  }

  .details :global(li + li) {
    margin-top: 0.4em;
  }

  .details :global(li::marker) {
    color: var(--color-card-red);
  }
</style>
