---
import { getEntry } from 'astro:content';
import SectionTitle from './SectionTitle.astro';

const { table } = (await getEntry('profile', 'main'))!.data;
// Stacks stand in proportion to member counts when every team has one, and all the same height otherwise.
const counted = table.teams.every((team) => team.members);
const tallest = counted ? Math.max(...table.teams.map((team) => team.members!)) : 1;
const height = (members?: number) => (counted ? members! / tallest : 1);
// Felt green would vanish against the felt, so the stacks take turns in the other three clays.
const chips = ['--color-cream', '--color-panel', '--color-card-red'];
const byline = [table.role, table.dates].filter(Boolean).join(' · ');
---

<section id="the-table" class="lamp-pool px-6 py-16 md:px-12 md:py-24">
  <div class="mx-auto grid max-w-7xl items-end gap-16 md:grid-cols-2">
    <div>
      <SectionTitle id="the-table" />
      {table.org && <h3 class="mt-8 text-h3" data-follow>{table.org}</h3>}
      {byline && <p class="mt-2 text-cream/80" data-follow>{byline}</p>}
      {table.summary && <p class="mt-6 max-w-[60ch]" data-follow>{table.summary}</p>}
    </div>
    {
      table.teams.length > 0 && (
        <ul class="stacks" role="list" data-follow>
          {table.teams.map((team, i) => (
            <li>
              <span
                class="stack"
                style={`--height: ${height(team.members)}; --chip: var(${chips[i % chips.length]})`}
                aria-hidden="true"
              />
              <span class="mt-3">{team.name}</span>
              {counted && <span class="text-small text-cream/80">{team.members}</span>}
            </li>
          ))}
        </ul>
      )
    }
    {
      table.highlights.length > 0 && (
        <ul class="moments md:col-span-2" role="list" data-follow>
          {table.highlights.map((moment) => (
            <li>
              <h3 class="moment">{moment.title}</h3>
              <p>{moment.body}</p>
            </li>
          ))}
        </ul>
      )
    }
    {table.lesson && <p class="lesson md:col-span-2" data-follow>{table.lesson}</p>}
  </div>
</section>

<style>
  /* The year's moments: a short title, then what happened, each set off by a brass rule. */
  .moments {
    display: grid;
    gap: 1.5rem 2.5rem;
  }

  @media (min-width: 1024px) {
    .moments {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .moments li {
    padding-left: 1rem;
    border-left: 1px solid color-mix(in srgb, var(--color-brass) 70%, transparent);
  }

  .moment {
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .moments p {
    margin-top: 0.25rem;
    color: color-mix(in srgb, var(--color-cream) 85%, transparent);
  }

  /* What the month taught: the last word, in lamp light. */
  .lesson {
    margin-top: -1.5rem;
    max-width: 60ch;
    font-size: 1.25rem;
    line-height: 1.5;
    color: var(--color-lamp);
  }

  .stacks {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    flex-wrap: wrap;
    gap: 2rem 3rem;
    text-align: center;
  }

  .stacks li {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* One chip per stripe, and the tallest team gets the full height. */
  .stack {
    width: 4.5rem;
    height: calc(var(--height) * 14rem);
    border-radius: 0.5rem;
    background: repeating-linear-gradient(
      to top,
      var(--chip) 0 0.5rem,
      color-mix(in srgb, var(--chip), black 40%) 0.5rem 0.625rem
    );
    box-shadow: 0 12px 24px -12px rgb(0 0 0 / 0.7);
  }
</style>
