---
import { getEntry } from 'astro:content';

const { player } = (await getEntry('profile', 'main'))!.data;
---

<section id="the-player" class="lamp-pool px-6 py-16 md:px-12 md:py-24">
  <div class="on-cream mx-auto grid max-w-6xl gap-12 rounded-panel p-8 shadow-2xl md:grid-cols-[minmax(0,1fr)_20rem] md:p-16">
    <div>
      <h2 class="text-h2">The Player</h2>
      {player.blurb && <p class="mt-6 max-w-[62ch]" data-follow>{player.blurb}</p>}
    </div>
    {
      player.stats.length > 0 && (
        <div class="stats self-start md:row-span-2" data-follow>
          <div class="bar">
            <span aria-hidden="true" />
            <span aria-hidden="true" />
            <span aria-hidden="true" />
            <button type="button" class="hud-toggle" aria-pressed="false" data-hud-toggle hidden>Performance HUD</button>
          </div>
          <dl>
            {player.stats.map((stat) => (
              <div class="row">
                <dt>{stat.label}</dt>
                <dd>{stat.value}</dd>
                {stat.note && <dd class="note">{stat.note}</dd>}
              </div>
            ))}
          </dl>
        </div>
      )
    }
    {/* Under the blurb on a wide screen, beside the stats; after the stats on a phone. */}
    {
      (player.education.length > 0 || player.skills.length > 0) && (
        <div class="md:col-start-1">
          {
            player.education.length > 0 && (
              <div data-follow>
                <h3 class="part">Education</h3>
                <ul class="schools" role="list">
                  {player.education.map((school) => (
                    <li>
                      <span class="school">{school.school}</span>
                      {school.program && <span>{school.program}</span>}
                      <span class="meta">{[school.place, school.dates].filter(Boolean).join(' · ')}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
          {
            player.skills.length > 0 && (
              <div class="mt-10" data-follow>
                <h3 class="part">Skills</h3>
                <dl class="skills">
                  {player.skills.map((group) => (
                    <div>
                      <dt>{group.group}</dt>
                      <dd>
                        <ul class="tags" role="list">
                          {group.items.map((item) => (
                            <li>{item}</li>
                          ))}
                        </ul>
                      </dd>
                    </div>
                  ))}
                </dl>
              </div>
            )
          }
        </div>
      )
    }
  </div>
</section>

<style>
  /* Education and skills under the blurb: a small head over a rule, then the entries. */
  .part {
    padding-bottom: 0.375rem;
    border-bottom: 1px solid var(--color-ink);
    font-size: var(--text-small);
    font-weight: 500;
  }

  .schools li {
    display: flex;
    flex-direction: column;
    padding: 0.75rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
  }

  .school {
    font-weight: 500;
  }

  .meta,
  .skills dt {
    font-size: var(--text-small);
    color: color-mix(in srgb, var(--color-ink) 75%, var(--color-cream));
  }

  .skills > div {
    display: grid;
    gap: 0.375rem 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
  }

  @media (min-width: 640px) {
    .skills > div {
      grid-template-columns: 7.5rem minmax(0, 1fr);
      align-items: baseline;
    }
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .tags li {
    border: 1px solid color-mix(in srgb, var(--color-ink) 30%, transparent);
    border-radius: var(--radius-chip);
    padding: 0 0.625rem;
    font-size: var(--text-small);
    line-height: 1.7;
  }

  .stats {
    border: 1px solid var(--color-brass);
    border-radius: var(--radius-panel);
    background: var(--color-panel);
    color: var(--color-cream);
    font-family: var(--font-plex-mono);
    font-size: var(--text-small);
    font-variant-numeric: tabular-nums;
    overflow: hidden;
  }

  .bar {
    display: flex;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-brass) 45%, transparent);
  }

  .bar span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-chip);
    background: color-mix(in srgb, var(--color-brass) 70%, transparent);
  }

  /* Hidden until the performance HUD renders something. */
  .hud-toggle {
    margin-left: auto;
    color: color-mix(in srgb, var(--color-cream) 75%, transparent);
  }

  .hud-toggle[aria-pressed='true'] {
    color: var(--color-brass);
  }

  .stats dl {
    padding: 0.5rem 1rem 0.75rem;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 1rem;
    padding: 0.5rem 0;
  }

  .row + .row {
    border-top: 1px solid color-mix(in srgb, var(--color-cream) 12%, transparent);
  }

  /* Right-aligned, so a value counting up grows toward its label. */
  .stats dt + dd {
    text-align: right;
  }

  .stats dt {
    color: color-mix(in srgb, var(--color-cream) 75%, transparent);
  }

  .note {
    flex-basis: 100%;
    color: color-mix(in srgb, var(--color-cream) 65%, transparent);
  }
</style>
