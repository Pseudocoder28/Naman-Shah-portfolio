---
// A section's heading: its poker name, then a brass rule and the plain name, smaller and quieter,
// so a visitor who doesn't play still knows what they're looking at. On a phone the plain name
// takes its own line under the poker one. Screen readers hear "Hand History, Experience".
import { SECTIONS, type SectionId } from '../../lib/state';

interface Props {
  id: SectionId;
  class?: string;
}

const { id, class: className } = Astro.props;
const { name, plain } = SECTIONS.find((section) => section.id === id)!;
---

<h2 class:list={['title text-h2', className]}>
  {name}
  {
    plain && (
      <span class="plain">
        <span class="sr-only">, </span>
        {plain}
      </span>
    )
  }
</h2>

<style>
  .title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 1rem;
  }

  .plain {
    display: inline-flex;
    align-items: baseline;
    gap: 1rem;
    font-size: 0.6em;
    line-height: 1;
    color: color-mix(in srgb, currentColor 72%, transparent);
  }

  /* The rule between the two names, in brass like the table's printed lines. It stands on the
     shared baseline, dipping just below it like a descender, and rises to the big name's caps. */
  .plain::before {
    content: '';
    width: 1px;
    height: 1.2em;
    translate: 0 0.2em;
    background: var(--color-brass);
  }

  @media (max-width: 639px) {
    .plain {
      flex-basis: 100%;
    }

    .plain::before {
      display: none;
    }
  }
</style>
