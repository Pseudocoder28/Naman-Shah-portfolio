---
// Faint brass orbits printed on the felt behind a section, like the rings of an astrolabe, with a
// suit pip riding each one. The pips move only with the scroll (motion.ts turns them through the
// section as it passes), so nothing loops, and without JavaScript or under reduced motion they rest
// where the server drew them. Decoration only: hidden from assistive tech and the pointer.
import { ORBITS, orbitPoint } from './orbits';

interface Props {
  /** Which edge the rings hang off, half out of the section. */
  side: 'left' | 'right';
  /** How far down the section the rings' centre sits, as a CSS length or percentage. */
  top?: string;
  /** The suits riding the rings, outermost first. */
  pips?: string;
}

const { side, top = '40%', pips = '♠♥♦♣' } = Astro.props;
const suits = [...pips];
---

<svg class:list={['orbits', side]} style={`--top: ${top}`} viewBox="-100 -100 200 200" aria-hidden="true" data-orbits>
  {ORBITS.map(({ rx, ry, tilt }) => <ellipse rx={rx} ry={ry} transform={`rotate(${tilt})`} />)}
  <circle class="hub" r="0.7" />
  {
    ORBITS.map((orbit, i) => {
      const { x, y, behind } = orbitPoint(orbit, 0);
      const suit = suits[i % suits.length];
      return (
        <g class:list={['pip', { behind, red: suit === '♥' || suit === '♦' }]} transform={`translate(${x} ${y})`} data-pip={i}>
          <circle r="5.2" />
          <text dy="0.36em">{suit}</text>
        </g>
      );
    })
  }
</svg>

<style>
  .orbits {
    position: absolute;
    top: var(--top);
    z-index: -1;
    width: min(64rem, 120vw);
    translate: 0 -50%;
    pointer-events: none;
    overflow: visible;
  }

  .orbits.left {
    left: max(-30rem, -50vw);
  }

  .orbits.right {
    right: max(-30rem, -50vw);
  }

  ellipse {
    fill: none;
    stroke: color-mix(in srgb, var(--color-brass) 22%, transparent);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
  }

  .hub {
    fill: color-mix(in srgb, var(--color-brass) 40%, transparent);
  }

  /* A pip is a small brass-rimmed chip with its suit, dimmer while it passes behind the hub. */
  .pip circle {
    fill: var(--color-felt-shadow);
    stroke: color-mix(in srgb, var(--color-brass) 70%, transparent);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
  }

  .pip text {
    font-size: 6.5px;
    text-anchor: middle;
    fill: var(--color-cream);
  }

  .pip.red text {
    fill: color-mix(in srgb, var(--color-card-red), var(--color-cream) 25%);
  }

  .pip {
    opacity: 0.55;
    transition: opacity 0.4s;
  }

  .pip.behind {
    opacity: 0.22;
  }
</style>
