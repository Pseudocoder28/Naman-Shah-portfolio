---
import { getEntry } from 'astro:content';
import { PIPS, type Suit } from '../../lib/deck';

const { experience, suits, drawing, site } = (await getEntry('profile', 'main'))!.data;
// Suits no card is dealt in yet. The legend shows them as open, and the drawing line asks for them.
const held = new Set(experience.map((job) => job.suit));
const open = suits ? Object.keys(suits).filter((suit) => !held.has(suit as Suit)) : [];
const title = (suit: string) => suit[0].toUpperCase() + suit.slice(1);
---

<section id="hand-history" class="lamp-pool px-6 py-16 md:px-12 md:py-24">
  <div class="mx-auto max-w-7xl">
    <h2 class="text-h2">Hand History</h2>
    <ol class="row mt-12" role="list">
      {
        experience.map((job, i) => {
          // A card only flips when there is something on its back.
          const hasBack = job.details.length > 0 || job.tags.length > 0;
          const Face = hasBack ? 'button' : 'div';
          const when = [job.start, job.end].filter(Boolean).join(' – ');
          const meta = [job.location, when].filter(Boolean).join(' · ');
          const flip = hasBack ? { type: 'button', 'aria-expanded': 'false', 'aria-controls': `job-${i}` } : {};
          return (
            <li class="slot">
              <Face class:list={['face card-stock', { red: job.suit === 'hearts' || job.suit === 'diamonds' }]} {...flip}>
                {job.suit && (
                  <span class="pip" role="img" aria-label={title(job.suit)}>
                    {PIPS[job.suit]}
                  </span>
                )}
                {job.company && <span class="company">{job.company}</span>}
                {job.role && <span>{job.role}</span>}
                {meta && <span class="meta">{meta}</span>}
                {job.result && <span class="result">{job.result}</span>}
                {/* Says the card turns over, so nobody misses that the details are on its back. */}
                {hasBack && (
                  <span class="turn">
                    Turn over for the details<span aria-hidden="true"> ↻</span>
                  </span>
                )}
                {job.suit && (
                  <span class="pip end" aria-hidden="true">
                    {PIPS[job.suit]}
                  </span>
                )}
              </Face>
              {hasBack && (
                <div id={`job-${i}`} class="back card-stock">
                  {job.details.length > 0 && (
                    <ul class="details">
                      {job.details.map((detail) => (
                        <li>{detail}</li>
                      ))}
                    </ul>
                  )}
                  {job.tags.length > 0 && (
                    <ul class="tags" role="list">
                      {job.tags.map((tag) => (
                        <li>{tag}</li>
                      ))}
                    </ul>
                  )}
                  <span class="turn" aria-hidden="true">
                    Turn back ↺
                  </span>
                </div>
              )}
            </li>
          );
        })
      }
    </ol>
    {
      suits && (
        <ul class="legend" role="list" data-follow>
          {Object.entries(suits).map(([suit, meaning]) => (
            <li class:list={{ open: open.includes(suit) }}>
              <span aria-hidden="true">{PIPS[suit as Suit]}</span>
              <span class="sr-only">{title(suit)}:</span> {meaning}
            </li>
          ))}
        </ul>
      )
    }
    {
      drawing && open.length > 0 && (
        <p class="drawing" data-follow>
          {drawing.line}{' '}
          {drawing.cta && site.email && (
            <a href={`mailto:${site.email}`} class="deal-in">
              {drawing.cta}
            </a>
          )}
        </p>
      )
    }
  </div>
</section>

<script>
  // Flips a card to its back and back again. Clicks on the back flip it too, and motion.ts
  // animates the turn from its own listener, which runs after this one.
  for (const face of document.querySelectorAll('#hand-history button.face')) {
    face.parentElement!.addEventListener('click', () => {
      face.setAttribute('aria-expanded', String(face.getAttribute('aria-expanded') !== 'true'));
    });
  }
</script>

<style>
  /* Phones scroll a row of cards. Wider screens deal them left to right at a readable width. */
  .row {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 1rem;
  }

  /* Wide enough on a phone that the back's details don't run the card long, with the next card
     peeking in at the edge. */
  .slot {
    display: grid;
    flex: 0 0 min(20rem, 82vw);
    scroll-snap-align: center;
  }

  @media (min-width: 768px) {
    .row {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(15rem, 20rem));
      overflow: visible;
    }
  }

  .face,
  .back {
    grid-area: 1 / 1;
    /* Grid items with aspect-ratio neither stretch nor shrink by default. Pin the width and
       stretch the height, so the tallest back grows the whole row down, not out of its column. */
    width: 100%;
    min-width: 0;
    align-self: stretch;
    aspect-ratio: 63 / 88;
    font-size: var(--text-small);
    line-height: 1.45;
    text-align: left;
  }

  .face {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 3rem 1rem;
  }

  .pip {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    font-size: 1.375rem;
    line-height: 1;
  }

  .pip.end {
    top: auto;
    left: auto;
    right: 0.75rem;
    bottom: 0.75rem;
    rotate: 180deg;
  }

  .red .pip {
    color: var(--color-card-red);
  }

  .company {
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .meta {
    color: color-mix(in srgb, var(--color-ink) 70%, transparent);
  }

  .result {
    margin-block: 0.5rem;
  }

  /* The cue to turn the card: an ink pill at the foot of the face, red under the pointer, like
     the morning paper's "Read the full story". */
  .turn {
    align-self: flex-start;
    margin-top: auto;
    padding: 0.2rem 0.8rem;
    border-radius: var(--radius-chip);
    background: var(--color-ink);
    color: var(--color-cream);
    font-weight: 500;
    box-shadow: 0 2px 0 color-mix(in srgb, var(--color-ink) 35%, transparent);
    transition: background-color 0.35s cubic-bezier(0.215, 0.61, 0.355, 1);
  }

  .face:hover .turn,
  .face:focus-visible .turn,
  .back:hover .turn {
    background: var(--color-card-red);
  }

  @media (prefers-reduced-motion: reduce) {
    .turn {
      transition: none;
    }
  }

  /* Without JavaScript nothing turns: the back already lies open under the face. */
  :global(html:not(.js)) .turn {
    display: none;
  }

  /* Positioned like the face, so DOM order puts the back on top when it shows. */
  .back {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem 1rem;
    outline: 1px solid color-mix(in srgb, var(--color-brass) 60%, transparent);
    outline-offset: -0.5rem;
  }

  .details {
    display: grid;
    gap: 0.5rem;
    padding-left: 1rem;
    list-style: disc;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }


  .tags li {
    border: 1px solid color-mix(in srgb, var(--color-ink) 30%, transparent);
    border-radius: var(--radius-chip);
    padding: 0 0.5rem;
  }

  /* Without JavaScript the back sits open under the front, so every detail stays readable. */
  :global(html:not(.js)) .slot {
    align-content: start;
  }

  :global(html:not(.js)) .back {
    grid-area: 2 / 1;
    aspect-ratio: auto;
    margin-top: 0.75rem;
  }

  :global(.js) .back {
    visibility: hidden;
  }

  :global(.js) .face[aria-expanded='true'] + .back {
    visibility: visible;
  }

  /* Focus stays on the face, so the back wears the ring while it's showing. */
  .face[aria-expanded='true']:focus-visible + .back {
    outline: 2px solid var(--color-brass);
    outline-offset: 3px;
  }

  /* The 3D flip from motion.ts: the back is printed on the far side and the slot turns over. */
  .flip-3d .slot {
    transform-style: preserve-3d;
  }

  .flip-3d .face,
  .flip-3d .back {
    backface-visibility: hidden;
  }

  .flip-3d .back {
    transform: rotateY(180deg);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 2rem;
    font-size: var(--text-small);
    color: color-mix(in srgb, var(--color-cream) 80%, transparent);
  }

  /* A suit still in the deck: drawn as an empty seat, a dashed outline round its meaning. */
  .legend .open {
    border: 1px dashed color-mix(in srgb, var(--color-brass) 70%, transparent);
    border-radius: var(--radius-chip);
    padding: 0 0.625rem;
  }

  .drawing {
    max-width: 62ch;
    margin-top: 1.25rem;
    color: var(--color-cream);
  }

  .deal-in {
    color: var(--color-lamp);
    text-decoration: underline;
    text-underline-offset: 4px;
    white-space: nowrap;
  }

  .deal-in:hover {
    color: var(--color-cream);
  }
</style>
