---
// The question a first-time visitor sees over the table: do you play? Yes deals them in: the two cards
// they picked fly down to the table as the question clears, and the hand is dealt. No takes them to
// the morning paper. It opens from an inline script as the page parses, so the table never flashes
// up first, and without JavaScript it never opens at all.
import { getEntry } from 'astro:content';
import { shouldAsk } from '../../lib/seat';

const { straight } = (await getEntry('profile', 'main'))!.data;
const gate = straight?.gate;
// The same function the tests cover, compiled and written into the page.
const script = `(() => {
  const ask = ${shouldAsk.toString()};
  const dialog = document.getElementById('seat');
  const search = location.search;
  // ?seat has done its job once read, so a refresh of the same page asks again.
  if (search) history.replaceState(null, '', location.pathname + location.hash);
  const navigation = performance.getEntriesByType('navigation')[0]?.type;
  if (ask({ search, navigation })) dialog.showModal();
  // The motion pass deals on this event, or on the flag if it hasn't loaded yet.
  const deal = () => {
    document.documentElement.dataset.deal = 'now';
    document.dispatchEvent(new Event('seat:deal'));
  };
  dialog.addEventListener('click', (event) => {
    const choice = event.target.closest('[data-seat]');
    if (!choice || dialog.classList.contains('leaving') || choice.dataset.seat !== 'poker') return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return dialog.close(), deal();
    // The panel clears and the two cards drop toward the table, where the deal picks them up.
    dialog.classList.add('leaving');
    choice.querySelectorAll('.hole').forEach((card, i) => {
      const side = i ? -1 : 1;
      card.animate(
        [{}, { transform: 'translate(' + side * 3 + 'rem, 60vh) rotate(' + side * 14 + 'deg) scale(0.6)', opacity: 0 }],
        { duration: 650, delay: i * 70, easing: 'cubic-bezier(0.55, 0.06, 0.68, 0.19)', fill: 'forwards' },
      );
    });
    setTimeout(() => (dialog.close(), deal()), 600);
  });
})();`;
---

{
  gate && (
    <>
      <dialog id="seat" class="seat" aria-labelledby="seat-question" aria-describedby="seat-note">
        <h2 id="seat-question" class="text-h2">{gate.question}</h2>
        {gate.note && <p id="seat-note" class="mt-3 text-cream/80">{gate.note}</p>}
        <div class="choices">
          <button type="button" class="choice deal-in" data-seat="poker" autofocus>
            <span class="hole under" aria-hidden="true" />
            <span class="hole over card-stock">
              <span class="pip" aria-hidden="true">♠</span>
              <span class="label">{gate.yes}</span>
              <span class="pip end" aria-hidden="true">♠</span>
            </span>
          </button>
          <a class="choice paper" href="/straight" data-seat="straight">
            <span class="masthead" aria-hidden="true">{straight.masthead}</span>
            <span class="label">{gate.no}</span>
            <span class="lines" aria-hidden="true" />
          </a>
        </div>
      </dialog>
      <script is:inline set:html={script} />
    </>
  )
}

<style>
  .seat {
    width: min(36rem, calc(100% - 2rem));
    margin: auto;
    border: 1px solid var(--color-brass);
    border-radius: var(--radius-panel);
    padding: 2.5rem;
    background: var(--color-rail);
    color: var(--color-cream);
    text-align: center;
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.8);
  }

  .seat::backdrop {
    background: color-mix(in srgb, var(--color-room) 75%, transparent);
    backdrop-filter: blur(3px);
  }

  /* Yes clears the panel while its cards fall to the table, so they mustn't be clipped by it. */
  .seat {
    overflow: visible;
    transition:
      background-color 0.4s cubic-bezier(0.215, 0.61, 0.355, 1),
      border-color 0.4s cubic-bezier(0.215, 0.61, 0.355, 1),
      box-shadow 0.4s cubic-bezier(0.215, 0.61, 0.355, 1);
  }

  .seat::backdrop {
    transition: opacity 0.5s cubic-bezier(0.215, 0.61, 0.355, 1);
  }

  .seat.leaving {
    border-color: transparent;
    background-color: transparent;
    box-shadow: none;
  }

  .seat.leaving::backdrop {
    opacity: 0;
  }

  .seat > :not(.choices),
  .choice.paper {
    transition: opacity 0.3s cubic-bezier(0.215, 0.61, 0.355, 1);
  }

  .seat.leaving > :not(.choices),
  .seat.leaving .choice.paper {
    opacity: 0;
  }

  /* The cards leave their button behind, so its focus ring goes too. */
  .seat.leaving .deal-in {
    outline: none;
  }

  .choices {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 2rem;
  }

  /* Two things to pick up: a playing card for the table, a folded morning paper for the rest. */
  .choice {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 10rem;
    padding: 2rem 1rem;
    border-radius: var(--radius-card);
    color: var(--color-ink);
    font-size: 1.25rem;
    line-height: 1.3;
    transition:
      translate 0.35s cubic-bezier(0.215, 0.61, 0.355, 1),
      rotate 0.35s cubic-bezier(0.215, 0.61, 0.355, 1);
  }

  .choice:hover,
  .choice:focus-visible {
    translate: 0 -4px;
    rotate: -1.5deg;
  }

  .choice.paper:hover,
  .choice.paper:focus-visible {
    rotate: 1.5deg;
  }

  /* Yes is a hand of two: a face card with a second card behind it that fans out under the pointer,
     the way a hand opens when you look at it. */
  .deal-in {
    padding: 0;
    background: none;
  }

  .deal-in:hover,
  .deal-in:focus-visible {
    translate: none;
    rotate: none;
  }

  .hole {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 2rem 1rem;
    border-radius: var(--radius-card);
    transition:
      translate 0.45s cubic-bezier(0.215, 0.61, 0.355, 1),
      rotate 0.45s cubic-bezier(0.215, 0.61, 0.355, 1);
  }

  .under {
    border: 0.35rem solid var(--color-cream);
    background: repeating-linear-gradient(
      45deg,
      var(--color-card-red) 0 0.3rem,
      color-mix(in srgb, var(--color-card-red), black 25%) 0.3rem 0.6rem
    );
    box-shadow: 0 16px 28px -14px rgb(0 0 0 / 0.65);
    rotate: 3deg;
    translate: 0.35rem -0.2rem;
  }

  .deal-in:hover .under,
  .deal-in:focus-visible .under {
    rotate: 12deg;
    translate: 1.6rem -0.6rem;
  }

  .deal-in:hover .over,
  .deal-in:focus-visible .over {
    rotate: -4deg;
    translate: -0.5rem -0.35rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .hole {
      transition: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .choice {
      transition: none;
    }
  }

  .pip {
    position: absolute;
    top: 0.6rem;
    left: 0.75rem;
    font-size: 1.25rem;
  }

  .pip.end {
    top: auto;
    left: auto;
    right: 0.75rem;
    bottom: 0.6rem;
    rotate: 180deg;
  }

  .paper {
    border-radius: 2px;
    background: var(--color-cream);
    box-shadow:
      0 1px 1px rgb(0 0 0 / 0.25),
      0 16px 28px -14px rgb(0 0 0 / 0.65);
  }

  .masthead {
    position: absolute;
    top: 0.6rem;
    inset-inline: 0.75rem;
    padding-bottom: 0.2rem;
    border-bottom: 3px double color-mix(in srgb, var(--color-ink) 35%, transparent);
    font-size: 0.8rem;
    font-weight: 500;
  }

  /* Columns of type, suggested, under the headline. */
  .lines {
    position: absolute;
    inset: auto 0.75rem 0.75rem;
    height: 1.5rem;
    background: repeating-linear-gradient(transparent 0 4px, color-mix(in srgb, var(--color-ink) 15%, transparent) 4px 5px);
  }

  @media (max-width: 479px) {
    .seat {
      padding: 1.75rem 1.25rem;
    }

    .choice {
      min-height: 8.5rem;
      font-size: 1.0625rem;
    }
  }
</style>
