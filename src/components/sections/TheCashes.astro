---
import { getEntry } from 'astro:content';

const { awards } = (await getEntry('profile', 'main'))!.data;
---

{
  awards.length > 0 && (
    <section id="the-cashes" class="lamp-pool px-6 py-16 md:px-12 md:py-24">
      <div class="mx-auto max-w-7xl">
        <h2 class="text-h2">The Cashes</h2>
        <ol class="tickets mt-12" role="list" data-follow>
          {awards.map((award) => (
            <li class="ticket card-stock">
              {award.year && <span class="year">{award.year}</span>}
              <div class="body">
                <h3 class="name">{award.name}</h3>
                {award.result && <p class="result">{award.result}</p>}
                {award.note && <p class="note">{award.note}</p>}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}

<style>
  .tickets {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 1rem;
  }

  /* A tournament ticket: the year on a stub, torn off along a brass perforation. */
  .ticket {
    display: flex;
  }

  .year {
    display: grid;
    place-items: center;
    flex: 0 0 4.25rem;
    font-size: var(--text-small);
    font-variant-numeric: tabular-nums;
    writing-mode: vertical-rl;
    rotate: 180deg;
    letter-spacing: 0.04em;
  }

  .body {
    border-left: 2px dotted color-mix(in srgb, var(--color-brass), var(--color-ink) 30%);
    padding: 1rem 1.25rem 1.125rem;
  }

  .name {
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .result {
    margin-top: 0.25rem;
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
    font-variant-numeric: tabular-nums;
    color: var(--color-card-red);
  }

  .note {
    margin-top: 0.375rem;
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    color: color-mix(in srgb, var(--color-ink) 80%, var(--color-cream));
  }
</style>
