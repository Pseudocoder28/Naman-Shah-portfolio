---
import { getEntry } from 'astro:content';
import SectionTitle from './SectionTitle.astro';

const { awards } = (await getEntry('profile', 'main'))!.data;
// A ticket opens a sheet only when the sheet has more than the ticket shows. Browsers without
// invoker commands get show-modal and close from The Board's script, which listens on the document.
const hasSheet = (award: (typeof awards)[number]) => Boolean(award.about) || award.stats.length > 0;
---

{
  awards.length > 0 && (
    <section id="the-cashes" class="lamp-pool px-6 py-16 md:px-12 md:py-24">
      <div class="mx-auto max-w-7xl">
        <SectionTitle id="the-cashes" />
        <ol class="tickets mt-12" role="list" data-follow>
          {awards.map((award, i) => {
            // Without JavaScript, invoker commands still open the sheet in browsers that support them.
            const Ticket = hasSheet(award) ? 'button' : 'div';
            const opens = hasSheet(award)
              ? { type: 'button', commandfor: `cash-${i}`, command: 'show-modal', 'aria-haspopup': 'dialog' }
              : {};
            return (
              <li>
                <Ticket class="ticket card-stock" {...opens}>
                  {award.year && <span class="year">{award.year}</span>}
                  <span class="body">
                    <span class="name">{award.name}</span>
                    {award.full && <span class="full">{award.full}</span>}
                    {award.result && <span class="result">{award.result}</span>}
                    {award.note && <span class="note">{award.note}</span>}
                    {hasSheet(award) && <span class="more">See the field</span>}
                  </span>
                </Ticket>
              </li>
            );
          })}
        </ol>
      </div>

      {awards.map(
          (award, i) =>
            hasSheet(award) && (
              <dialog id={`cash-${i}`} class="sheet on-cream" aria-labelledby={`cash-${i}-name`} closedby="any">
                <div class="flex items-start justify-between gap-6">
                  <h3 id={`cash-${i}-name`} class="text-h3">
                    {[award.name, award.year].filter(Boolean).join(' ')}
                  </h3>
                  <button type="button" class="close" commandfor={`cash-${i}`} command="close">
                    Close
                  </button>
                </div>
                {award.about && <p class="mt-3">{award.about}</p>}
                {award.stats.length > 0 && (
                  <dl class="figures mt-6">
                    {award.stats.map((stat) => (
                      <div class="row">
                        <dt>{stat.label}</dt>
                        <dd>{stat.value}</dd>
                      </div>
                    ))}
                  </dl>
                )}
                {award.source && (
                  <p class="source mt-6">
                    Source:{' '}
                    <a href={award.source.href} target="_blank" rel="noopener" class="underline underline-offset-4">
                      {award.source.label}
                    </a>
                  </p>
                )}
              </dialog>
            ),
      )}
    </section>
  )
}

<style>
  .tickets {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 1rem;
  }

  /* A tournament ticket: the year on a stub, torn off along a brass perforation. */
  .ticket {
    display: flex;
    width: 100%;
    height: 100%;
    text-align: left;
    transition: translate 0.35s cubic-bezier(0.215, 0.61, 0.355, 1);
  }

  button.ticket:hover {
    translate: 0 -3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .ticket {
      transition: none;
    }

    button.ticket:hover {
      translate: none;
    }
  }

  .year {
    display: grid;
    place-items: center;
    flex: 0 0 4.25rem;
    font-size: var(--text-small);
    font-variant-numeric: tabular-nums;
    writing-mode: vertical-rl;
    rotate: 180deg;
    letter-spacing: 0.04em;
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    border-left: 2px dotted color-mix(in srgb, var(--color-brass), var(--color-ink) 30%);
    padding: 1rem 1.25rem 1.125rem;
  }

  .name {
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .result {
    margin-top: 0.25rem;
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
    font-variant-numeric: tabular-nums;
    color: var(--color-card-red);
  }

  .note {
    margin-top: 0.375rem;
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    color: color-mix(in srgb, var(--color-ink) 80%, var(--color-cream));
  }

  .full {
    font-size: var(--text-small);
    line-height: 1.35;
    color: color-mix(in srgb, var(--color-ink) 72%, transparent);
  }

  .more {
    margin-top: auto;
    padding-top: 0.75rem;
    font-size: var(--text-small);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: color-mix(in srgb, var(--color-brass), var(--color-ink) 30%);
  }

  .sheet {
    width: min(36rem, calc(100% - 2rem));
    max-height: calc(100% - 2rem);
    margin: auto;
    border: 1px solid var(--color-brass);
    border-radius: var(--radius-panel);
    padding: 2rem;
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.7);
  }

  .sheet::backdrop {
    background: color-mix(in srgb, var(--color-room) 70%, transparent);
  }

  /* The same fade and scale as The Board's project sheets. */
  .sheet,
  .sheet::backdrop {
    transition:
      opacity 0.35s cubic-bezier(0.215, 0.61, 0.355, 1),
      scale 0.35s cubic-bezier(0.215, 0.61, 0.355, 1),
      overlay 0.35s allow-discrete,
      display 0.35s allow-discrete;
  }

  .sheet:not([open]),
  .sheet:not([open])::backdrop {
    opacity: 0;
  }

  .sheet:not([open]) {
    scale: 0.96;
  }

  @starting-style {
    .sheet[open],
    .sheet[open]::backdrop {
      opacity: 0;
    }

    .sheet[open] {
      scale: 0.96;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet,
    .sheet::backdrop {
      scale: none !important;
      transition-duration: 0.15s;
    }
  }

  .close {
    flex: none;
    border: 1px solid color-mix(in srgb, var(--color-ink) 40%, transparent);
    border-radius: var(--radius-chip);
    padding: 0.25rem 1rem;
  }

  /* Label left, figure right, a hairline between rows. The first row is Naman's own result. */
  .figures {
    font-variant-numeric: tabular-nums;
  }

  .figures .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 1.5rem;
    padding: 0.5rem 0;
  }

  .figures .row + .row {
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
  }

  .figures .row:first-child dd {
    color: var(--color-card-red);
  }

  .figures dd {
    text-align: right;
  }

  .source {
    font-size: var(--text-small);
    color: color-mix(in srgb, var(--color-ink) 80%, var(--color-cream));
  }
</style>
